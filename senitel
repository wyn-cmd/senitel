#!/usr/bin/env python3

# Senitel GUI: a password and seed prompt in front of vault_core.

import tkinter as tki
from tkinter import Label

import vault_core

HEIGHT = 300
WIDTH = 400


def build_window():
    root = tki.Tk()
    root.title("Senitel")
    tki.Canvas(root, height=HEIGHT, width=WIDTH).grid()

    frame = tki.Frame(root, bg="black")
    frame.place(relx=0.01, rely=0.01, relwidth=0.98, relheight=0.98)

    seed_entry = tki.Entry(frame, font=30, show="*")
    seed_entry.place(relwidth=0.65, relheight=0.11, y=125, x=66)

    password_entry = tki.Entry(frame, font=30, show="*")
    password_entry.place(relwidth=0.65, relheight=0.11, y=40, x=66)

    status = Label(root, bg="black", fg="white")
    status.place(x=99, y=175)

    def report(text):
        status.config(text=text)

    def run():
        password = password_entry.get()
        seed = seed_entry.get()
        try:
            outcome = vault_core.toggle(password, seed)
        except ValueError:
            report("      ***Password is Incorrect***      ")
        except FileNotFoundError:
            report("   ***No vault or archive found***   ")
        except Exception as exc:
            report(f"   ***Error: {exc}***   ")
        else:
            report(f"       ***Senitel {outcome.capitalize()}***       ")

    tki.Button(
        root, text="enter", bg="white", fg="black", font=180, command=run
    ).place(relx=0.34, rely=0.73, relwidth=0.3, relheight=0.18)

    Label(text="password:", bg="black", fg="white").place(x=165, y=18)
    Label(text="seed:", bg="black", fg="white").place(x=180, y=102)

    return root


if __name__ == "__main__":
    build_window().mainloop()
